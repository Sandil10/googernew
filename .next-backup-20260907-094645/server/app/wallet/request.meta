{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/wallet/layout,_N_T_/wallet/request/layout,_N_T_/wallet/request/page,_N_T_/wallet/request"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/wallet/request/__PAGE__",
    "/wallet/request",
    "/wallet",
    "/_index",
    "/_head"
  ]
}