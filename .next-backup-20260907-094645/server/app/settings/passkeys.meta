{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/settings/layout,_N_T_/settings/passkeys/layout,_N_T_/settings/passkeys/page,_N_T_/settings/passkeys"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/settings/passkeys/__PAGE__",
    "/settings/passkeys",
    "/settings",
    "/_index",
    "/_head"
  ]
}