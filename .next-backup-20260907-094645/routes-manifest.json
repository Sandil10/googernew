{
  "version": 3,
  "pages404": true,
  "appType": "hybrid",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/login",
      "destination": "/home",
      "statusCode": 307,
      "regex": "^(?!/_next)/login(?:/)?$"
    },
    {
      "source": "/terms",
      "destination": "/terms-and-policies",
      "statusCode": 307,
      "regex": "^(?!/_next)/terms(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/uploads/:path*.jfif",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ],
      "regex": "^/uploads(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?\\.jfif(?:/)?$"
    },
    {
      "source": "/uploads/:path*.jpe",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ],
      "regex": "^/uploads(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?\\.jpe(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/:path*",
        "destination": "http://127.0.0.1:5000/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/uploads/:path*",
        "destination": "http://127.0.0.1:5000/uploads/:path*",
        "regex": "^/uploads(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/socket.io/:path*",
        "destination": "http://127.0.0.1:5000/socket.io/:path*",
        "regex": "^/socket\\.io(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/shop/:id",
        "destination": "/dashboard/shop?id=:id",
        "regex": "^/shop(?:/([^/]+?))(?:/)?$"
      },
      {
        "source": "/shop/:id/:reseller",
        "destination": "/dashboard/shop?id=:id&reseller=:reseller",
        "regex": "^/shop(?:/([^/]+?))(?:/([^/]+?))(?:/)?$"
      }
    ],
    "fallback": []
  },
