# Copy to .env on the target Ubuntu/Docker server for production.

WEB_URL=https://your-main-domain.example
ADMIN_URL=https://your-admin-domain.example
MOBILE_URL=https://your-main-domain.example

DATABASE_URL=
DB_HOST=managed-postgres-host
DB_PORT=5432
DB_NAME=googer
DB_USER=googer_app
DB_PASSWORD=replace-with-production-password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=30
ADMIN_DB_POOL_MAX=12
WORKER_DB_POOL_MAX=8
NOTIFICATION_DB_POOL_MAX=12
NOTIFICATION_WORKER_DB_POOL_MAX=8

POSTGRES_DB=googer
POSTGRES_USER=googer
POSTGRES_PASSWORD=googer_password_change_me

JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
OPS_MONITOR_TOKEN=replace-with-a-long-random-ops-token

CLUSTER_WORKERS=2
WORKER_STALE_AFTER_SECONDS=120

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FORCE_LOCAL_UPLOADS=false

PUBLIC_UPLOAD_CONTENT_CACHE_TTL_MS=15000
