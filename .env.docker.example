# Copy this file to .env.docker and fill real secrets before running Docker.

# Public app origins
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
MOBILE_URL=http://localhost:3000

# Database: use a managed PostgreSQL URL for production.
# For local Postgres via compose profile, use:
# DATABASE_URL=postgresql://googer:googer_password_change_me@postgres:5432/googer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20
ADMIN_DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5

# Backend auth
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars

# Main backend cluster workers per container
CLUSTER_WORKERS=2

# Optional CDN/media provider. Strongly recommended for production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FORCE_LOCAL_UPLOADS=false

# Cache tuning
PUBLIC_UPLOAD_CONTENT_CACHE_TTL_MS=15000
