PORT=5000
NODE_ENV=production

DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=Googer
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_SSL=require
DB_SSL_REJECT_UNAUTHORIZED=true

WEB_URL=https://your-main-app-domain.com
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

FASTFOREX_API_KEY=replace-with-your-fastforex-key
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_RENEWAL_SWEEP_SECONDS=15
