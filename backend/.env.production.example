PORT=5000
NODE_ENV=production

# Database (RDS)
DB_HOST=googer-db.ctssuq0g0svg.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=Googer
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL=require
DB_SSL_REJECT_UNAUTHORIZED=false

# URLs
WEB_URL=https://app.infranex.it.com
MOBILE_URL=*

# Auth — change this to a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_here
JWT_EXPIRE=7d

# Cloudinary — required for file uploads in production
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
